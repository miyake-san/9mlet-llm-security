# ==========================================================================
# .env.example — Aula 02 (Guardrails e Políticas de Segurança para LLMs)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Espaço mínimo entre chamadas; mantenha >= 1 para evitar 429.
GROQ_MIN_INTERVAL_SECONDS=1

# --- Papel do processo FastAPI: "gateway" (padrão) ou "rag" -----------------
# gateway  -> aplica as camadas de guardrail e encaminha ao rag-api (porta 8080)
# rag       -> Aurora Assist backend (RAG/chat) que fala com o LLM (porta 8000)
APP_ROLE=gateway

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Classificador de safety menor (Doc 04, seção 7).
LLAMA_GUARD_MODEL=llama-guard3:1b
# Baixe com: ollama pull llama3.2:3b && ollama pull llama-guard3:1b
LLAMA_GUARD_MODEL=llama-guard3:1b

# --- Topologia gateway -> rag-api ------------------------------------------
# URL do backend RAG que o gateway protege. No compose: http://rag-api:8000
RAG_API_URL=http://rag-api:8000
# URL do gateway usada por notebooks / avaliação `task scan`.
AURORA_GATEWAY_URL=http://localhost:8080

# --- Azure AI Content Safety (opcional; camada de moderação — Doc 04 §7) ---
# Requer: uv sync --group azure. Se vazio, usa o classificador stub local.
# AACS_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
# AACS_KEY=
# Limite de severidade (0-6) para bloqueio. Doc 04, Figura 3 / Tabela 2.
AACS_BLOCK_THRESHOLD=4

# --- Azure OpenAI / Azure AI Foundry (opcional; se LLM_BACKEND=azure) -------
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Parâmetros gerais ------------------------------------------------------
# Timeout (s) das chamadas ao LLM / serviços externos.
LLM_TIMEOUT=60
# Nível de log (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
