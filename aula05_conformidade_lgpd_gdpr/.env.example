# ==========================================================================
# .env.example — Aula 05 (Conformidade: LGPD, GDPR e EU AI Act)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- Azure OpenAI / Azure AI Foundry (opcional; usado se LLM_BACKEND=azure) 
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aurora Assist COMPLIANT (rag-api) -------------------------------------
# Versão do modelo/app registrada no registro de tratamento (proveniência, art. 37).
MODEL_VERSION=aurora-assist-2.5.0
# Classificação EU AI Act do sistema: "limited" (informar) | "high" (decidir crédito).
# Manter "limited" reduz drasticamente o fardo regulatório (Doc 04, §7).
AI_ACT_RISK_TIER=limited
# Transparência EU AI Act (risco limitado): informar que é uma IA em cada resposta.
AI_DISCLOSURE_ENABLED=true
# Recusar pedidos de DECISÃO automatizada de crédito (GDPR art. 22; Doc 04, §5,§7).
REFUSE_AUTOMATED_CREDIT_DECISION=true
# Minimização de dados no prompt (Presidio/detector determinístico) — LGPD art. 6, V.
MINIMIZE_PII=true
# Exigir consentimento válido para a finalidade antes de tratar (LGPD art. 7/11).
ENFORCE_CONSENT=true

# --- Residência de dados (Schrems II; Doc 04, §11) -------------------------
# Região onde os dados residem fisicamente (evidência de conformidade).
DATA_RESIDENCY_REGION=brazil-south

# --- consent-service (consentimento granular e versionado — Doc 04, §Hands On) ---
# URL usada pela rag-api para verificar consentimento por finalidade.
CONSENT_SERVICE_URL=http://consent-service:8010
# Store do consentimento: "memory" (offline/testes) | "file" | "postgres".
CONSENT_STORE=memory
CONSENT_STORE_PATH=/tmp/consent_store.jsonl
# Versão vigente dos termos de uso (o titular aceita uma versão específica).
CONSENT_TERMS_VERSION=2026-06-v3

# --- Postgres (store do consent-service; usado se CONSENT_STORE=postgres) ---
# Requer: uv sync --group postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aurora_consent
POSTGRES_USER=aurora
# Em produção use um segredo forte via Key Vault; aqui é só laboratório.
POSTGRES_PASSWORD=aurora-dev-only

# --- Registro de tratamento / trilha WORM (art. 37 LGPD / art. 30 GDPR) ----
# Caminho da hash chain do registro de operações (WORM lógico no lab).
TREATMENT_LOG_PATH=/tmp/treatment_chain.jsonl

# --- Vector store (direito ao esquecimento — purga seletiva; Doc 04, §10) --
# "memory" (offline) | "qdrant". Análogo didático ao Azure AI Search.
VECTOR_STORE=memory
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=aurora_rag

# --- Microsoft Presidio (minimização de dados; opcional) -------------------
# Se ausentes, a rag-api usa o detector determinístico BR (offline).
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# --- Diversos --------------------------------------------------------------
LLM_TIMEOUT=60
LOG_LEVEL=INFO
