# syntax=docker/dockerfile:1.9
###############################################################################
# redteam-ci / aibom-gen (Aula 08) — runner do pipeline DevSecOps (Doc 04, §9).
# Imagem PESADA (opt-in, profile `security`): instala o grupo `security` com as
# ferramentas reais (CycloneDX ML-BOM, PyRIT, Garak). O gate offline usa as
# implementações puras de src/security; aqui elas podem ser trocadas pelas reais.
# Roda o deploy gate e escreve reports/ (Doc 04, §§6-9).
###############################################################################

FROM ghcr.io/astral-sh/uv:0.5.11 AS uv

FROM python:3.12.7-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/root/.cargo/bin:/opt/venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl build-essential \
 && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml ./
# Instala runtime + grupo `security` (CycloneDX/PyRIT/Garak).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --group security --no-install-project

FROM python:3.12.7-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="aurora-redteam-ci" \
      org.opencontainers.image.description="Aula 08 — deploy gate DevSecOps (red team + AIBOM + governança)" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/work \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 10001 runner \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin runner

WORKDIR /work
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 app/ ./app/
COPY --chown=10001:10001 src/ ./src/
COPY --chown=10001:10001 configs/ ./configs/
COPY --chown=10001:10001 data/ ./data/
COPY --chown=10001:10001 scripts/ ./scripts/

USER 10001:10001

# Avalia o agent-app ao vivo e aplica o deploy gate (falha o container se bloquear).
CMD ["python", "-m", "app.deploy_gates", \
     "--target", "http://agent-app:8000", \
     "--report", "/work/reports/deploy_report.json", \
     "--gate"]
