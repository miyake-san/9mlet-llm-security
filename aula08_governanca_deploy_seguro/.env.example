# ==========================================================================
# .env.example — Aula 08 (Governança de IA e Implantação Segura em Produção)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- Azure OpenAI / Azure AI Foundry (opcional; LLM_BACKEND=azure) ---------
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aurora Assist v3.0 (agente candidato) --------------------------------
# Versão registrada nos relatórios de deploy e no AIBOM (proveniência).
MODEL_VERSION=aurora-assist-3.0.0

# MITIGAÇÃO (Doc 04, §9): guardrails (Aula 2) + grounding estrito + redação de PII.
# false = agente INGÊNUO (jailbreak escapa, alucina, PII vaza) -> deploy gate REPROVA.
# true  = agente ENDURECIDO (guardrails ligados) -> deploy gate APROVA.
AGENT_GUARDRAILS_ENABLED=false

# Isolamento de ferramentas MCP (Aula 03).
MCP_ENABLED=true

# --- Deployment seguro (Doc 04, §6) ---------------------------------------
# Estratégia: canary | blue_green | shadow. Percentual inicial do canary.
DEPLOYMENT_STRATEGY=canary
CANARY_PERCENT=5

# --- SLO / deploy gate (Doc 04, §§6-7) ------------------------------------
SLO_PATH=configs/slo.yaml
THRESHOLDS_PATH=configs/thresholds.yaml

# --- Observabilidade (Aula 06 / Doc 04, §9) -------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
COST_INPUT_PER_1K=0.005
COST_OUTPUT_PER_1K=0.015

# --- redteam-ci / deploy gate ao vivo -------------------------------------
TARGET_API_URL=http://agent-app:8000
REPORT_DIR=/work/reports

# --- Serviços do compose (Langfuse/Postgres/Grafana) — segredos DEV apenas -
POSTGRES_DB=langfuse
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse-dev-only
NEXTAUTH_SECRET=changeme-nextauth-dev-only
LANGFUSE_SALT=changeme-salt-dev-only

# --- Diversos --------------------------------------------------------------
LLM_TIMEOUT=60
LOG_LEVEL=INFO
