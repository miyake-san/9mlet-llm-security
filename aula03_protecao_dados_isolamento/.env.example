# ==========================================================================
# .env.example — Aula 03 (Proteção de Dados e Isolamento de Ferramentas)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- Presidio (detecção/anonimização de PII — Doc 04, §5-6) ----------------
# Modo do bridge:
#   deterministic = engine offline em Python puro (regex + checksum) — PADRÃO/CI.
#   http          = usa os serviços Presidio do docker-compose (produção do lab).
#   python        = usa a lib presidio local (requer: uv sync --group presidio).
PRESIDIO_MODE=deterministic
# Endpoints HTTP quando PRESIDIO_MODE=http (no compose, por nome de serviço):
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000
# Idioma do modelo de NLP do Presidio (recognizers BR + NER).
PRESIDIO_LANGUAGE=pt

# --- Cofre de tokens / anonimização reversível (Doc 04, §7) ----------------
# Backend do cofre: "memory" (padrão/CI), "file" (persistente local) ou "azure".
TOKEN_VAULT_BACKEND=memory
# Caminho do cofre quando TOKEN_VAULT_BACKEND=file.
TOKEN_VAULT_PATH=/app/reports/token_vault.json
# Segredo (HMAC) para gerar tokens determinísticos e não reversíveis por adivinhação.
# Em produção venha do Key Vault; aqui é só um valor de laboratório.
TOKEN_HMAC_SECRET=troque-este-segredo-em-producao

# --- Isolamento de ferramentas / MCP (Doc 04, §9-10) -----------------------
# URL do servidor de ferramentas MCP (rede INTERNA no compose; sem egress).
MCP_SERVER_URL=http://mcp-server:8090
# Segredo para assinar/verificar capability tokens (HMAC).
MCP_CAPABILITY_SECRET=troque-este-segredo-de-capacidade
# TTL (segundos) dos capability tokens emitidos pelo rag-api.
MCP_CAPABILITY_TTL=120

# --- Azure Key Vault (opcional; TOKEN_VAULT_BACKEND=azure — Doc 04, §7) -----
# Requer: uv sync --group azure. Suporta Managed Identity (Entra ID) — §2.
# AZURE_KEY_VAULT_URL=https://<seu-cofre>.vault.azure.net/

# --- Azure OpenAI / Azure AI Foundry (opcional; se LLM_BACKEND=azure) -------
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Topologia usada por notebooks / avaliação `task scan` -----------------
AURORA_API_URL=http://localhost:8000

# --- Parâmetros gerais ------------------------------------------------------
# Timeout (s) das chamadas ao LLM / serviços externos.
LLM_TIMEOUT=60
# Nível de log (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
