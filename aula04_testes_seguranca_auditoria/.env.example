# ==========================================================================
# .env.example — Aula 04 (Red Teaming, Testes de Segurança e Auditoria)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- Azure OpenAI / Azure AI Foundry (opcional; usado se LLM_BACKEND=azure) 
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aurora Assist DEFENDIDO (target-api) — alvo do red team ---------------
# Versão do modelo/app registrada na trilha de auditoria (proveniência).
MODEL_VERSION=aurora-assist-2.4.0
# Guardrail de superfície liga/desliga (para medir linha de base vs mitigação).
GUARDRAIL_ENABLED=true
# Mitigação: normalizar ofuscação (leet/base64) ANTES de filtrar (Doc 04, sec. 13).
# false = guardrail imperfeito (evasões passam); true = mitigação aplicada.
GUARDRAIL_NORMALIZE=false
# Mitigação: avaliar a CONVERSA inteira (defesa contra crescendo — Doc 04, sec. 8).
GUARDRAIL_CONVERSATION=false

# --- Trilha de auditoria (audit-log) --------------------------------------
# URL usada pela target-api para emitir eventos assinados por hash chain.
AUDIT_LOG_URL=http://audit-log:8091
# Habilita/desabilita emissão de auditoria (desligado nos testes em processo).
AUDIT_ENABLED=true
# Arquivo de persistência da cadeia (WORM lógico) dentro do container.
AUDIT_CHAIN_PATH=/tmp/audit_chain.jsonl

# --- OpenSearch (SIEM — análogo ao Azure Sentinel) ------------------------
# best-effort: se indisponível, a auditoria continua (não-fatal).
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=aurora-audit

# --- Campanha de red team (redteam-ci) ------------------------------------
# URL do alvo dentro da rede do compose.
TARGET_API_URL=http://target-api:8000
REPORT_DIR=/work/reports

# --- Diversos --------------------------------------------------------------
LLM_TIMEOUT=60
LOG_LEVEL=INFO
