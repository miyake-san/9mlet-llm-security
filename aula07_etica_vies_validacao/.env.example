# ==========================================================================
# .env.example — Aula 07 (Ética, Viés e Validação de Qualidade em LLMs)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- Azure OpenAI / Azure AI Evaluation SDK (opcional; LLM_BACKEND=azure) ---
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aurora Assist (RAG) — target-api avaliada ----------------------------
# Versão do modelo/app registrada nos relatórios de avaliação (proveniência).
MODEL_VERSION=aurora-assist-2.5.0

# Mitigação de FAIRNESS (Doc 04, "Viés específico de LLMs" e "Fairlearn").
# false = assistente ingênuo: o atributo protegido (grupo) influencia a decisão
#         e a recomendação de produto -> disparidade demográfica mensurável.
# true  = mitigação aplicada: o grupo é neutralizado -> disparidade ~0.
FAIRNESS_MITIGATION=false

# Mitigação de GROUNDEDNESS/RAG (Doc 04, "Avaliação de RAG, RAGAS").
# false = assistente alucina quando o fato não está no contexto -> faithfulness baixa.
# true  = assistente abstém-se ("não encontrei nos documentos") -> faithfulness alta.
RAG_STRICT_GROUNDING=false

# Nº de documentos recuperados pelo retriever offline (RAG).
RAG_TOP_K=3

# --- LLM-as-Judge (Doc 04, "LLM-as-Judge e seus vieses") ------------------
# Mitigação de position bias: alterna a ordem das respostas e agrega (Zheng 2023).
JUDGE_DEBIAS_POSITION=true
# Nº de juízes no ensemble (agregação por consenso).
JUDGE_ENSEMBLE_SIZE=3

# --- Quality gate (Doc 04, "quality gates éticos no CI/CD") ---------------
# Caminho do arquivo de limiares versionado (política aprovada pela governança).
THRESHOLDS_PATH=configs/thresholds.yaml

# --- eval-runner (avaliação contínua conteinerizada) ----------------------
# URL do alvo dentro da rede do compose.
TARGET_API_URL=http://target-api:8000
REPORT_DIR=/work/reports

# --- Diversos --------------------------------------------------------------
LLM_TIMEOUT=60
LOG_LEVEL=INFO
