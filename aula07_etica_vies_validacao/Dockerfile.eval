# syntax=docker/dockerfile:1.9
###############################################################################
# eval-runner (Aula 07) — avaliação responsável contínua contra a target-api.
# Imagem PESADA (opt-in, profile `eval`): instala o grupo `eval` com as
# bibliotecas de referência (Fairlearn, bert-score, RAGAS). O pipeline offline
# usa as implementações puras de src/security; aqui elas podem ser trocadas
# pelas reais. Executa o quality gate e escreve reports/ (Doc 04, "CI/CD").
###############################################################################

FROM ghcr.io/astral-sh/uv:0.5.11 AS uv

FROM python:3.12.7-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
COPY pyproject.toml ./
# Instala runtime + grupo `eval` (Fairlearn/bert-score/RAGAS).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev --group eval --no-install-project

FROM python:3.12.7-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="aurora-eval-runner" \
      org.opencontainers.image.description="Aula 07 — avaliação contínua (fairness+RAGAS+juiz) + quality gate" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/work \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 10001 evaluator \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin evaluator

WORKDIR /work
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 app/ ./app/
COPY --chown=10001:10001 src/ ./src/
COPY --chown=10001:10001 configs/ ./configs/
COPY --chown=10001:10001 data/ ./data/

USER 10001:10001

# Avalia a target-api ao vivo e aplica o quality gate (falha o container se reprovar).
CMD ["python", "-m", "app.eval_ragas", \
     "--target", "http://target-api:8000", \
     "--report", "/work/reports/eval_report.json", \
     "--gate"]
