{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["aurora", "llmops", "aula06"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Aurora LLMOps — Qualidade, Custo e Segurança",
  "uid": "aurora-llmops",
  "version": 1,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latência P95 (ms) — SLO < 2000ms",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(aurora_request_latency_ms_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Custo acumulado (USD)",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "sum(aurora_cost_usd_total)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio (economia de tokens)",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "sum(aurora_cache_hits_total) / clamp_min(sum(aurora_requests_total), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Vazamentos de PII (Data SLO <= 1%)",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "sum(aurora_pii_leaks_total)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taxa de requests por backend",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "sum(rate(aurora_requests_total[5m])) by (backend)",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens/s (entrada vs saída)",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "sum(rate(aurora_tokens_total[5m])) by (direction)",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Score de drift por método (KS/PSI/MMD/Wasserstein)",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "aurora_drift_score",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Groundedness (proxy) — SLO >= 0.95",
      "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aurora-prometheus" },
          "expr": "aurora_groundedness",
          "legendFormat": "groundedness"
        }
      ]
    }
  ]
}
