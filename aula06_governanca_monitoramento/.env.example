# ==========================================================================
# .env.example — Aula 06 (LLMOps: Governança de Dados e Monitoramento Contínuo)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- Azure OpenAI / Azure AI Foundry (opcional; usado se LLM_BACKEND=azure) 
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aurora Assist v2.6 (app OTel-instrumentado) ---------------------------
# Versão do modelo/app registrada nos spans gen_ai.* (proveniência; Doc 04, §Obs.).
MODEL_VERSION=aurora-assist-2.6.0
# Nível de maturidade LLMOps alvo (0 manual | 1 CI/CD | 2 automação governada) — Doc 04.
LLMOPS_MATURITY_LEVEL=1
# Minimização de PII antes de logar telemetria (observabilidade sem virar risco — Doc 04).
MINIMIZE_TELEMETRY_PII=true

# --- Observabilidade: OpenTelemetry (convenções gen_ai.*) — Doc 04, §Obs. --
# Se OTEL_EXPORTER_OTLP_ENDPOINT estiver setado E o grupo `otel` instalado, o app
# exporta spans reais; caso contrário usa o coletor em memória (offline).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=aurora-assist
OTEL_TRACES_ENABLED=true

# --- Langfuse: tracing por step (latência/tokens/custo) — Doc 04, §Obs. ----
# Requer: uv sync --group langfuse. O serviço `langfuse` do compose é o backend/UI.
# Gere as chaves na UI (http://localhost:3000) após subir a stack.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# --- Postgres (backend do Langfuse) ----------------------------------------
POSTGRES_DB=langfuse
POSTGRES_USER=langfuse
# Em produção use um segredo forte via Key Vault; aqui é só laboratório.
POSTGRES_PASSWORD=langfuse-dev-only

# --- Langfuse (segredos do container; laboratório apenas) ------------------
# NEXTAUTH_URL deve bater com a porta publicada (3000).
NEXTAUTH_URL=http://localhost:3000
# Gere valores fortes em produção: `openssl rand -base64 32`.
NEXTAUTH_SECRET=changeme-nextauth-dev-only
LANGFUSE_SALT=changeme-salt-dev-only

# --- Modelo de custo / SLOs (token economics — Doc 04, §"token economics") -
# Preços por 1K tokens (USD) para o cálculo de custo por request nos spans.
COST_INPUT_PER_1K=0.005
COST_OUTPUT_PER_1K=0.015
# Roteamento de modelo: prompts simples vão ao modelo barato; complexos ao caro.
MODEL_ROUTING_ENABLED=true
# Caching semântico: reutiliza resposta quando a similaridade de cosseno >= limiar.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92

# --- Detecção de drift (janelas de tráfego — Doc 04, §Drift) ---------------
DRIFT_REFERENCE_PATH=data/traffic/reference.jsonl
DRIFT_PRODUCTION_PATH=data/traffic/production.jsonl

# --- Diversos --------------------------------------------------------------
LLM_TIMEOUT=60
LOG_LEVEL=INFO
