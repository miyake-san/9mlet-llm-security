# ==========================================================================
# .env.example — Aula 01 (Ameaças e Vulnerabilidades em LLMs)
# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# ==========================================================================

# --- Backend de LLM: "groq" (padrão), "ollama", "azure" ou "stub" ---
# stub = backend determinístico sem rede (usado em testes/CI e demos offline).
LLM_BACKEND=groq

# --- Ollama (execução local, sem nuvem) -----------------------------------
# Dentro do docker compose o host é "ollama"; fora dele, "localhost".
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- Groq (padrão; requer chave) --------------------------------------------
# Crie a chave em https://console.groq.com/keys e não a versione no Git.
# LLM_BACKEND=groq
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MIN_INTERVAL_SECONDS=1

# --- Azure OpenAI / Azure AI Foundry (opcional; usado se LLM_BACKEND=azure) 
# Requer: uv sync --group azure
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Aplicação vulnerável (Aurora Assist v0 — SEM guardrails, por design) --
# URL usada por notebooks e pelo redteam-runner para atacar a API.
AURORA_API_URL=http://localhost:8000
# Timeout (s) das chamadas ao LLM.
LLM_TIMEOUT=60
# Nível de log (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
