# ==========================================================================
# .env.example — 9mlet-llm-security
# Copie para .env e preencha conforme necessário.
# NUNCA versione o .env com segredos reais (ele está no .gitignore).
# ==========================================================================

# --- Backend de LLM: "ollama" (offline-first, padrão) ou "azure" ----------
LLM_BACKEND=ollama

# --- Ollama (execução local, sem nuvem) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Classificador de safety usado na Aula 2 (guardrails):
OLLAMA_GUARD_MODEL=llama-guard3:8b

# --- Azure OpenAI / Azure AI Foundry (opcional; usado se LLM_BACKEND=azure) 
# AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Azure AI Content Safety (AACS + Prompt Shield — Aula 2) ---------------
# AACS_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
# AACS_API_KEY=

# --- Langfuse (observabilidade / tracing — Aula 6) -------------------------
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Azure Key Vault (tokenização reversível de PII — Aula 3; opcional) ----
# AZURE_KEY_VAULT_URL=https://<seu-kv>.vault.azure.net/

# --- Diversos --------------------------------------------------------------
# Nível de log da aplicação (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=INFO
